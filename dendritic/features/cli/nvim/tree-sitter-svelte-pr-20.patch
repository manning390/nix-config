From c283e7981dde83c5e09cb2bfb3a81280a8ab451a Mon Sep 17 00:00:00 2001
From: may <m4rch3n1ng@gmail.com>
Date: Tue, 23 Sep 2025 17:19:04 +0200
Subject: [PATCH 1/3] parse `@attach` svelte syntax

---
 grammar.js | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/grammar.js b/grammar.js
index c39de05..35254dd 100644
--- a/grammar.js
+++ b/grammar.js
@@ -119,6 +119,7 @@ module.exports = grammar(HTML, {
           )),
         ),
         alias($.expression, $.attribute_name),
+        $.attach_tag,
       ),
     ),
 
@@ -297,6 +298,14 @@ module.exports = grammar(HTML, {
       '}',
     ),
 
+    _attach_tag: _ => tag('@', 'attach'),
+    attach_tag: $ => seq(
+      '{',
+      alias($._attach_tag, $.expression_tag),
+      $._tag_value,
+      '}'
+    ),
+
     attribute_name: _ => /[^<>{}"'/=\s]+/,
 
     attribute_value: _ => /[^<>{}"'=\s]+/,

From 628d28fef25d2de137721b7683bda7dd1be7a34f Mon Sep 17 00:00:00 2001
From: may <m4rch3n1ng@gmail.com>
Date: Tue, 23 Sep 2025 17:25:07 +0200
Subject: [PATCH 2/3] add test for `@attach` syntax

---
 test/corpus/snippets.txt | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/test/corpus/snippets.txt b/test/corpus/snippets.txt
index ffabd9b..3cc2796 100644
--- a/test/corpus/snippets.txt
+++ b/test/corpus/snippets.txt
@@ -262,3 +262,26 @@ Snippet (in component)
     (end_tag
       (tag_name)))
 )
+
+============================
+@attach 
+============================
+<button {@attach tooltip(content)} class="test">
+	Hover me
+</button>
+----------------------------
+(document
+  (element
+    (start_tag
+      (tag_name)
+      (attribute
+        (attach_tag
+          (expression_tag)
+          (svelte_raw_text)))
+      (attribute
+        (attribute_name)
+        (quoted_attribute_value
+          (attribute_value))))
+    (text)
+    (end_tag
+      (tag_name))))

